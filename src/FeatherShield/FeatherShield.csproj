<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FeatherShield</PackageId>
    <Version>1.0.0</Version>
    <Description>Standalone blocking engine used by Feather Browser.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.js">
      <LogicalName>FeatherShield.Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
